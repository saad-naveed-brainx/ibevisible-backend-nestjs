# Port the NestJS API listens on
PORT=3000

# Comma-separated list of allowed CORS origins (the frontend dev server)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=ibevisible_user
DATABASE_PASSWORD=
DATABASE_NAME=ibevisible

# JWT auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OpenAI API (AI content drafting)
OPENAI_API_KEY=
